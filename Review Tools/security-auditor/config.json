{
  "models": {
    "basic": "haiku",
    "advanced": "sonnet"
  },
  "diff": {
    "baseRef": "origin/HEAD",
    "untrackedMaxBytes": 100000
  },
  "scan": {
    "exclude": [
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "**/testdata/**",
      "**/bin/**",
      "**/obj/**",
      "*.Designer.cs",
      "*.md",
      "*.tsbuildinfo",
      "*.snap"
    ],
    "testFiles": {
      "mode": "lower-confidence",
      "patterns": [
        "*.test.*",
        "*.spec.*",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**"
      ]
    },
    "projectStack": "backend"
  },
  "scope": {
    "maxRelatedFiles": 5,
    "maxRelationshipHops": 1
  }
}